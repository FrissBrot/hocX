# Prod-Umgebung (docker-compose.release.yml + docker-compose.clamav.yml +
# docker-compose.traefik.yml). Kopie als .env.prod anlegen, echte Werte eintragen -
# NIE committen.

# Release-Version, die auf diesem Server laufen soll - immer eine konkrete Version
# pinnen, nie "latest" (siehe RUNBOOK.md).
HOCX_VERSION=v1.1.2
HOCX_ENVIRONMENT=production
# GitHub-Namespace (kleingeschrieben) der Container-Images, z.B. frissbrot
GHCR_NAMESPACE=your-github-org-lowercase
# Erlaubte GitHub-Actions-Signer-Identitaet fuer Cosign. (?i) macht den
# Repository-Owner unempfindlich gegen Gross-/Kleinschreibung.
HOCX_SIGNING_IDENTITY_REGEXP=(?i)^https://github.com/your-github-org-lowercase/hocx/.github/workflows/build-test-images[.]yml@refs/heads/main$
# Minimaler freier Speicher vor einem Deploy in KiB (Default: 2 GiB).
# HOCX_MIN_FREE_KB=2097152
# Praefix fuer Traefik-Router-/Service-Namen. Auf Prod (eigener Traefik, keine
# Kollisionsgefahr) kann das Default "hocx" bleiben - einfach nicht setzen.
# ROUTER_PREFIX=hocx

POSTGRES_DB=hocx
POSTGRES_USER=hocx
POSTGRES_PASSWORD=change-me-to-a-random-32-plus-char-value
# Admin/migration connection (superuser role) - used by alembic (see alembic/env.py).
DATABASE_URL=postgresql+psycopg://hocx:change-me-to-a-random-32-plus-char-value@db:5432/hocx
# Runtime connection for the backend itself, using the least-privilege 'hocx_app' role
# instead of the superuser role above (see alembic/versions/0070_restrict_app_db_role.py).
# Use a different random value than POSTGRES_PASSWORD/DATABASE_URL's password.
APP_DB_PASSWORD=change-me-to-a-different-random-32-plus-char-value
APP_DATABASE_URL=postgresql+psycopg://hocx_app:change-me-to-a-different-random-32-plus-char-value@db:5432/hocx
TRAEFIK_DOMAIN=hocx.ch
TRAEFIK_ADMIN_DOMAIN=admin.your-domain.example.com
# Oeffentliche Website/Landing Page (optional, z.B. die Hauptdomain hocx.ch). Leer = keine Website.
TRAEFIK_WEBSITE_DOMAIN=
# Kontaktadresse der Website (Demo/Kontakt/Plan-Buttons als mailto). Leer = Buttons fuehren zum App-Login.
WEBSITE_CONTACT_EMAIL=
# Ziel von "Anmelden" auf der Website (z.B. https://app.hocx.ch). Leer = https://${TRAEFIK_DOMAIN}.
HOCX_APP_URL=
TRAEFIK_ADMIN_PORT=8443
ACME_EMAIL=your@email.com
# Cloudflare API Token: Zone:Zone:Read und Zone:DNS:Edit nur fuer die DNS-Zone;
# niemals den Global API Key verwenden.
CF_DNS_API_TOKEN=replace-with-a-restricted-cloudflare-api-token

# Host-Pfad fuer die auslagerbaren Originale/Exporte (StoredFile, exports, Dokumentvorlagen -
# siehe FileService). Default ist der lokale Ordner; sobald ein Cloud Volume gemountet ist,
# hier z.B. auf /mnt/hocx-data umstellen und "docker compose up -d" - kein Code-/Compose-Aendern
# noetig. storage-local/thumbnails ist bewusst NICHT darueber steuerbar, bleibt immer lokal.
HOCX_STORAGE_PATH=./storage

# Nur beim Update von 1.0.x auf 1.1.0 relevant (Migration 0078, "ein Konto = ein Mandant"):
# "auto" loest Konten mit mehreren Mandanten-Mitgliedschaften automatisch auf (behaelt die
# Mitgliedschaft des Standard-Mandanten, sonst die hoechste Rolle) und LOESCHT Konten ohne
# jeden Mandanten. Leer lassen, dann bricht die Migration in dem Fall ab und listet die Konten.
# HOCX_SINGLE_TENANT_RESOLUTION=auto

NEXT_PUBLIC_API_URL=https://hocx.ch
INTERNAL_API_URL=http://backend:8000
# Software-Dokumentation (docs-site/, MkDocs Material)
TRAEFIK_DOCS_DOMAIN=docs.hocx.ch
AUTH_SECRET=change-me-to-a-random-32-plus-char-value

# Platform-Admin-Panel (/admin) - eigenes, von AppUser/superadmin getrenntes System.
# Nur ueber OpenZiti unter https://${TRAEFIK_ADMIN_DOMAIN}/admin erreichbar.
# INITIAL_ADMIN_EMAIL/PASSWORD bootstrappen nur den allerersten Account (nur wirksam,
# solange die platform_admin-Tabelle leer ist); weitere Admins verwaltet man im Panel.
ADMIN_AUTH_SECRET=change-me-to-a-different-random-32-plus-char-value
INITIAL_ADMIN_EMAIL=admin@hocx.ch
INITIAL_ADMIN_PASSWORD=change-me-before-first-deploy

# Abgabebox (oeffentliche Upload-Box ohne Login, siehe abgabebox-backend/abgabebox-frontend)
TRAEFIK_ABGABEBOX_DOMAIN=abgabe.hocx.ch
ABGABEBOX_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
ABGABEBOX_DATABASE_URL=postgresql+psycopg://hocx_abgabebox:change-me-to-a-random-32-plus-char-value@db:5432/hocx

# Photo-analysis-worker (Phase 3 of photo-culling: face-quality scoring) - eigene,
# minimal-privilegierte DB-Rolle wie oben bei der Abgabebox.
PHOTO_WORKER_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
PHOTO_WORKER_DATABASE_URL=postgresql+psycopg://hocx_photo_worker:change-me-to-a-random-32-plus-char-value@db:5432/hocx

# Redis-Passwort (requirepass), nur im Release-Stack aktiv (MAIN-OPS-005).
REDIS_PASSWORD=change-me-to-a-random-32-plus-char-value

FRIENDLY_CAPTCHA_SITEKEY=your-friendly-captcha-sitekey
FRIENDLY_CAPTCHA_API_KEY=your-friendly-captcha-api-key
ABGABEBOX_CAPTCHA_SESSION_SECRET=change-me-to-a-random-32-plus-char-value

# --- Objektspeicher (S3) und lokales Garage-S3 (docs-site/docs/technik/storage/) ---
# deploy.sh erzeugt fehlende Werte automatisch (scripts/lib/env_migrate.sh) und überschreibt nie
# vorhandene. STORAGE_CREDENTIALS_KEY zusammen mit .env sichern - ohne ihn sind gespeicherte
# S3-Zugangsdaten nicht mehr entschlüsselbar. Garage-Access-Keys: GK + 24 Hex, Secrets: 64 Hex.
STORAGE_CREDENTIALS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
LOCAL_S3_ACCESS_KEY=
LOCAL_S3_SECRET_KEY=
LOCAL_S3_ABGABEBOX_ACCESS_KEY=
LOCAL_S3_ABGABEBOX_SECRET_KEY=
# Rückfallfrist abgelöster Speichergenerationen in Tagen
STORAGE_FALLBACK_DAYS=14

# --- Offsite-Backup: BorgBackup auf der Hetzner Storage Box (docs-site/docs/technik/backup/) ---
# Erst nach der Einrichtung (RUNBOOK Abschnitt 7) auf true setzen. Solange false, läuft der
# backup-worker im Leerlauf und die bisherigen Cronjobs backup_db/backup_storage bleiben aktiv.
BACKUP_ENABLED=false
BACKUP_STORAGEBOX_HOST=
BACKUP_STORAGEBOX_USER=
BACKUP_STORAGEBOX_PORT=23
BACKUP_REPOSITORY_PATH=hocx-borg
# Borg-Version auf der Storage Box (Hetzner bietet mehrere an)
BACKUP_REMOTE_PATH=borg-1.4
# Nach "cli init" ausgegebene Repository-ID (64 Hex) - Pinning gegen vertauschte Repositories
BACKUP_REPOSITORY_ID=
# Host-Key-Pinning: entweder known_hosts-Datei (BACKUP_KNOWN_HOSTS_PATH) oder SHA256-Fingerprint
BACKUP_SSH_HOST_FINGERPRINT=
# Pfade auf dem Host (Modus 600, Besitzer Deploy-Benutzer); deploy.sh kopiert sie nach .secrets/
BACKUP_SSH_KEY_PATH=
BACKUP_KNOWN_HOSTS_PATH=
BACKUP_PASSPHRASE=
# Lokales Staging (Datenbank-Dump) in Bytes, Upload-Limit in KiB/s (0 = unbegrenzt)
BACKUP_STAGING_MAX_BYTES=21474836480
BACKUP_UPLOAD_RATELIMIT_KIB=0
# Kapazität der Storage Box in Bytes für die Belegungswarnung (0 = unbekannt)
BACKUP_STORAGEBOX_QUOTA_BYTES=0
# Vor jedem Deploy ein geschütztes, abgeschlossenes Backup verlangen (required) oder bewusst
# darauf verzichten (skip, wird protokolliert). Zeitlimit in Sekunden.
HOCX_PRE_DEPLOY_BACKUP=required
HOCX_PRE_DEPLOY_BACKUP_TIMEOUT=7200
# Teilweise erfolgreiches Backup (Datenbank vollständig, einzelne Objekte fehlen bereits) vor dem
# Deploy akzeptieren und die fehlenden Objekte nur ausgeben (true) oder den Deploy abbrechen (false).
HOCX_PRE_DEPLOY_BACKUP_ALLOW_PARTIAL=true

# Öffentliche Prüfseite für PDFs (Abgabebox /verify). Steht in jedem PDF (Fusszeile, QR-Code,
# XMP) - bewusst die Plattform-Domain, gedruckte Links müssen stabil bleiben.
# Leer = ABGABEBOX_BASE_URL + /verify.
# DOCUMENT_VERIFY_BASE_URL=https://abgabe.example.com/verify
