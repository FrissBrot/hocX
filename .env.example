POSTGRES_DB=hocx
POSTGRES_USER=hocx
POSTGRES_PASSWORD=hocx
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hocx:hocx@db:5432/hocx
TRAEFIK_DOMAIN=your-domain.example.com
TRAEFIK_ADMIN_DOMAIN=admin.your-domain.example.com
# Nur der OpenZiti-Host-Tunnel greift auf https://127.0.0.1:8443 zu. Der Port
# bleibt durch das feste Loopback-Binding in Compose vom Internet unerreichbar.
TRAEFIK_ADMIN_PORT=8443
ACME_EMAIL=your@email.com
# Cloudflare API Token mit Zone:Zone:Read und Zone:DNS:Edit, eingeschraenkt auf
# die betroffene Zone.
# Nicht den Global API Key verwenden und echte Tokens niemals committen.
CF_DNS_API_TOKEN=replace-with-a-restricted-cloudflare-api-token

# Host-Pfad fuer die auslagerbaren Originale/Exporte (StoredFile, exports, Dokumentvorlagen -
# siehe FileService). Default ist der lokale Ordner; sobald ein Cloud Volume gemountet ist,
# hier z.B. auf /mnt/hocx-data umstellen und "docker compose up -d" - kein Code-/Compose-Aendern
# noetig.
HOCX_STORAGE_PATH=./storage

# Software-Dokumentation (docs-site/, MkDocs Material)
TRAEFIK_DOCS_DOMAIN=docs.your-domain.example.com
# Angezeigt klein auf der Login-Seite. Fuer Dev reicht "dev" - in Test/Prod wird das
# ueber HOCX_VERSION in der jeweiligen .env auf die tatsaechliche Release-Version gesetzt.
HOCX_VERSION=dev
NEXT_PUBLIC_API_URL=https://your-domain.example.com
# Bewusst NICHT http://backend:8000 (direkter Docker-Netzwerk-Zugriff): unter echter
# Nebenlaeufigkeit (mehrere gleichzeitige neue TCP-Verbindungen direkt zu uvicorn, z.B. beim
# Laden einer Seite mit mehreren parallelen Server-seitigen Fetches) liefert uvicorn dort
# nachweislich gelegentlich falsche Antworten fuer eine an sich gueltige Session zurueck (siehe
# Memory "Login-Loop" - reproduzierbar mit parallelen curl-Requests direkt gegen Port 8000,
# via Traefik/den oeffentlichen Domain-Pfad dagegen 100% zuverlaessig). Bis die Ursache in
# uvicorn/dessen Verbindungsannahme gefunden ist, laeuft interner SSR-Traffic deshalb ueber
# denselben oeffentlichen Pfad wie ein echter Browser.
INTERNAL_API_URL=https://your-domain.example.com
AUTH_SECRET=change-me-to-a-random-32-plus-char-value

# Platform-Admin-Panel (/admin) - eigenes, von AppUser/superadmin getrenntes System.
# Oeffentlich nicht unter TRAEFIK_DOMAIN erreichbar; Zugriff erfolgt unter
# https://${TRAEFIK_ADMIN_DOMAIN}/admin via OpenZiti.
# INITIAL_ADMIN_EMAIL/PASSWORD bootstrappen nur den allerersten Account (nur wirksam,
# solange die platform_admin-Tabelle leer ist); weitere Admins verwaltet man im Panel.
ADMIN_AUTH_SECRET=change-me-to-a-different-random-32-plus-char-value
INITIAL_ADMIN_EMAIL=admin@your-domain.example.com
INITIAL_ADMIN_PASSWORD=change-me-before-first-deploy

# Abgabebox (oeffentliche Upload-Box ohne Login, siehe abgabebox-backend/abgabebox-frontend)
TRAEFIK_ABGABEBOX_DOMAIN=abgabe.your-domain.example.com
ABGABEBOX_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
ABGABEBOX_DATABASE_URL=postgresql+psycopg://hocx_abgabebox:change-me-to-a-random-32-plus-char-value@db:5432/hocx
FRIENDLY_CAPTCHA_SITEKEY=your-friendly-captcha-sitekey
FRIENDLY_CAPTCHA_API_KEY=your-friendly-captcha-api-key
ABGABEBOX_CAPTCHA_SESSION_SECRET=change-me-to-a-random-32-plus-char-value
