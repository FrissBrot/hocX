POSTGRES_DB=hocx
POSTGRES_USER=hocx
POSTGRES_PASSWORD=hocx
POSTGRES_PORT=5432
# Admin/migration connection (superuser role) - used by alembic (see alembic/env.py).
DATABASE_URL=postgresql+psycopg://hocx:hocx@db:5432/hocx
# Runtime connection for the backend itself, using the least-privilege 'hocx_app' role
# instead of the superuser role above (see alembic/versions/0070_restrict_app_db_role.py).
APP_DB_PASSWORD=hocx_app
APP_DATABASE_URL=postgresql+psycopg://hocx_app:hocx_app@db:5432/hocx
TRAEFIK_DOMAIN=your-domain.example.com
TRAEFIK_ADMIN_DOMAIN=admin.your-domain.example.com
# Oeffentliche Website/Landing Page (optional, z.B. die Hauptdomain hocx.ch). Leer = keine Website.
TRAEFIK_WEBSITE_DOMAIN=
# Kontaktadresse der Website (Demo/Kontakt/Plan-Buttons als mailto). Leer = Buttons fuehren zum App-Login.
WEBSITE_CONTACT_EMAIL=
# Ziel von "Anmelden" auf der Website (z.B. https://app.hocx.ch). Leer = https://${TRAEFIK_DOMAIN}.
HOCX_APP_URL=
# Nur der OpenZiti-Host-Tunnel greift auf https://127.0.0.1:8443 zu. Der Port
# bleibt durch das feste Loopback-Binding in Compose vom Internet unerreichbar.
TRAEFIK_ADMIN_PORT=8443
# Host-eigene Dateien im Traefik-Dateiprovider-Verzeichnis infra/traefik/dynamic/ (nicht im Repo,
# z. B. ein eigenes TLS-Zertifikat). Nur hier genannte Dateinamen lässt die Deploy-Prüfung zu.
TRAEFIK_HOST_DYNAMIC_FILES=
ACME_EMAIL=your@email.com
# Cloudflare API Token mit Zone:Zone:Read und Zone:DNS:Edit, eingeschraenkt auf
# die betroffene Zone.
# Nicht den Global API Key verwenden und echte Tokens niemals committen.
CF_DNS_API_TOKEN=replace-with-a-restricted-cloudflare-api-token

# Host-Pfad fuer die auslagerbaren Originale/Exporte (StoredFile, exports, Dokumentvorlagen -
# siehe FileService). Default ist der lokale Ordner; sobald ein Cloud Volume gemountet ist,
# hier z.B. auf /mnt/hocx-data umstellen und "docker compose up -d" - kein Code-/Compose-Aendern
# noetig. storage-local/thumbnails ist bewusst NICHT darueber steuerbar, bleibt immer lokal.
HOCX_STORAGE_PATH=./storage

# Software-Dokumentation (docs-site/, MkDocs Material)
TRAEFIK_DOCS_DOMAIN=docs.your-domain.example.com
# Optional: öffentliche Statusseite (nur https). Die Update-Seite verweist darauf, wenn ein Update
# länger als 15 Minuten dauert (In-App und statische Wartungsseite, RUNBOOK Abschnitt 20).
# HOCX_STATUS_PAGE_URL=https://status.example.com
# Angezeigt klein auf der Login-Seite. Fuer Dev reicht "dev" - in Test/Prod wird das
# ueber HOCX_VERSION in der jeweiligen .env auf die tatsaechliche Release-Version gesetzt.
HOCX_VERSION=dev
NEXT_PUBLIC_API_URL=https://your-domain.example.com
# Immer intern (Security-Review L2, SEC-AUTH-001): Der Next.js-Server reicht bei Admin-Aufrufen den
# Gate-Header an dieses Ziel weiter - eine öffentliche Domain würde ihn nach aussen tragen. Früher
# stand hier die öffentliche Domain (Umgehung eines Login-Loops bei direktem uvicorn-Zugriff, behoben
# durch den Retry in lib/api/client.ts); scripts/deploy.sh verlangt jetzt ein internes Ziel.
INTERNAL_API_URL=http://backend:8000
AUTH_SECRET=change-me-to-a-random-32-plus-char-value

# Platform-Admin-Panel (/admin) - eigenes, von AppUser/superadmin getrenntes System.
# Oeffentlich nicht unter TRAEFIK_DOMAIN erreichbar; Zugriff erfolgt unter
# https://${TRAEFIK_ADMIN_DOMAIN}/admin via OpenZiti.
# INITIAL_ADMIN_EMAIL/PASSWORD bootstrappen nur den allerersten Account (nur wirksam,
# solange die platform_admin-Tabelle leer ist); weitere Admins verwaltet man im Panel.
ADMIN_AUTH_SECRET=change-me-to-a-different-random-32-plus-char-value
# ADMIN_GATE_SECRET (Auth-Audit SEC-AUTH-001) gibt es nur im Release-Stack (deploy.sh erzeugt ihn und
# die Traefik-Datei admin-gate.yml). Diese Quellcode-Instanz läuft in der Entwicklung ohne Gate;
# mit HOCX_ENVIRONMENT=production ist die Admin-API hier gesperrt - Produktion über scripts/deploy.sh.

# Öffentliche Prüfseite für PDFs (Abgabebox /verify). Steht in jedem PDF (Fusszeile, QR-Code).
# Leer = https://${TRAEFIK_ABGABEBOX_DOMAIN}/verify (ABGABEBOX_BASE_URL + /verify).
# DOCUMENT_VERIFY_BASE_URL=https://abgabe.example.com/verify
INITIAL_ADMIN_EMAIL=admin@your-domain.example.com
INITIAL_ADMIN_PASSWORD=change-me-before-first-deploy

# Abgabebox (oeffentliche Upload-Box ohne Login, siehe abgabebox-backend/abgabebox-frontend)
TRAEFIK_ABGABEBOX_DOMAIN=abgabe.your-domain.example.com
ABGABEBOX_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
ABGABEBOX_DATABASE_URL=postgresql+psycopg://hocx_abgabebox:change-me-to-a-random-32-plus-char-value@db:5432/hocx
FRIENDLY_CAPTCHA_SITEKEY=your-friendly-captcha-sitekey
FRIENDLY_CAPTCHA_API_KEY=your-friendly-captcha-api-key
ABGABEBOX_CAPTCHA_SESSION_SECRET=change-me-to-a-random-32-plus-char-value
# Friendly Captcha in der EU (Datenschutz-Audit E2, Plan mit EU-Endpunkt nötig):
#   FRIENDLY_CAPTCHA_PUZZLE_URL=https://eu-api.friendlycaptcha.eu/api/v1/puzzle
#   FRIENDLY_CAPTCHA_VERIFY_URL=https://eu-api.friendlycaptcha.eu/api/v1/siteverify
# Nicht gesetzt = globaler Endpunkt (api.friendlycaptcha.com); /admin/system zeigt, welcher aktiv ist.
# Datenschutzhinweise in der Abgabebox, wenn ein Verein keinen eigenen Link setzt (https://…):
#   ABGABEBOX_DEFAULT_PRIVACY_URL=https://example.org/datenschutz

# Datenschutz: Standort dieses Servers (ch, eu_eea, adequate, third_country) für das lokale
# Speicherprofil, optional erlaubte Standorte der Speicherprofile (z. B. ch,eu_eea; leer = alle)
# und Tage nach Vertragsende, bis /admin/system die Löschung eines Mandanten anmahnt.
HOCX_SERVER_LOCATION=ch
# STORAGE_ALLOWED_LOCATIONS=ch,eu_eea
TENANT_OFFBOARDING_GRACE_DAYS=90
# ABGABEBOX_ENVIRONMENT (CAPTCHA fail-open fuer dev/test vs. fail-closed) steht bewusst NICHT
# hier: abgabebox-backend bekommt diese .env per env_file komplett, eine Server-Instanz aus
# docker-compose.yml lief damit ohne Bot-Schutz (Audit MAIN-OPS-009). docker-compose.dev.yml
# (development) und docker-compose.e2e.yml (test) setzen den Wert selbst; ohne Wert gilt
# fail-closed.

# Photo-analysis-worker (Phase 3 of photo-culling: face-quality scoring, siehe
# photo-analysis-worker/README.md) - eigene, minimal-privilegierte DB-Rolle wie oben bei
# der Abgabebox.
PHOTO_WORKER_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
PHOTO_WORKER_DATABASE_URL=postgresql+psycopg://hocx_photo_worker:change-me-to-a-random-32-plus-char-value@db:5432/hocx
# Foto-Standorte (Migration 0260): eigene Rolle nur für den Import der Ortsdaten (job-worker).
GEO_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
GEO_DATABASE_URL=postgresql+psycopg://hocx_geo:change-me-to-a-random-32-plus-char-value@db:5432/hocx

# Redis-Passwort (requirepass), nur im Release-Stack aktiv (MAIN-OPS-005).
REDIS_PASSWORD=change-me-to-a-random-32-plus-char-value

# Optional: a base32 TOTP secret (e.g. openssl rand -base32 20) that scripts/seed_test_tenant.py
# enrolls for every demo account (admin/writer/reader/kassier@<slug>.hocx.local) instead of
# leaving them without MFA - add the same secret once to your own authenticator app and every
# reseed keeps working with it, no re-scanning a QR code each time. Leave unset to fall back to
# the normal enroll-on-first-login flow. Only ever read by that script - never copy this into
# .env.prod.example, and it has no effect there anyway since the seed script itself refuses to
# run against a HOCX_ENVIRONMENT=production backend.
DEMO_TOTP_SEED=

# --- Objektspeicher (S3) und lokales Garage-S3 (docs-site/docs/technik/storage/) ---
# deploy.sh erzeugt fehlende Werte automatisch (scripts/lib/env_migrate.sh) und überschreibt nie
# vorhandene. STORAGE_CREDENTIALS_KEY zusammen mit .env sichern - ohne ihn sind gespeicherte
# S3-Zugangsdaten nicht mehr entschlüsselbar. Garage-Access-Keys: GK + 24 Hex, Secrets: 64 Hex.
STORAGE_CREDENTIALS_KEY=
# Schlüssel der Mandanten-Exporte (64 Hex, von deploy.sh einmalig erzeugt). Zusammen mit .env
# sichern - ohne ihn sind Exporte, die ohne Passwort erstellt wurden, nicht mehr importierbar.
EXPORT_ENCRYPTION_KEY=

# --- Datei-Import aus Cloud-Diensten (RUNBOOK «Cloud-Import einrichten») ---
# Schlüssel der OAuth-Tokens (64 Hex, von deploy.sh einmalig erzeugt). Rotation: neuen Wert setzen,
# alten als CLOUD_IMPORT_TOKEN_KEY_PREVIOUS, nach 7 Tagen _PREVIOUS leeren.
CLOUD_IMPORT_TOKEN_KEY=
CLOUD_IMPORT_TOKEN_KEY_PREVIOUS=
CLOUD_IMPORT_ENABLED=true
# Basis der Redirect-URI; leer = https://TRAEFIK_DOMAIN
CLOUD_IMPORT_REDIRECT_BASE_URL=
# Microsoft Entra App (OneDrive, SharePoint). Leer = Microsoft wird nicht angeboten.
CLOUD_IMPORT_MS_CLIENT_ID=
CLOUD_IMPORT_MS_CLIENT_SECRET=
# Ablaufdatum des Client-Secrets (JJJJ-MM-TT) für den Monitoring-Check «Cloud-Import»
CLOUD_IMPORT_MS_CLIENT_SECRET_EXPIRES=
CLOUD_IMPORT_MS_AUTHORITY=common
# auto | tempauth | bearer (Download OneDrive for Business/SharePoint, tempauth endet am 1.4.2027)
CLOUD_IMPORT_MS_DOWNLOAD_MODE=auto
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
LOCAL_S3_ACCESS_KEY=
LOCAL_S3_SECRET_KEY=
LOCAL_S3_ABGABEBOX_ACCESS_KEY=
LOCAL_S3_ABGABEBOX_SECRET_KEY=
# Rückfallfrist abgelöster Speichergenerationen in Tagen
STORAGE_FALLBACK_DAYS=14

# --- Betrieb (optional) ---------------------------------------------------------------------
# deploy.sh traegt benoetigte Host-Cronjobs (storage_controller) selbst in die crontab des
# Deploy-Benutzers ein; false = von Hand verwalten (RUNBOOK Abschnitt 10).
# HOCX_MANAGE_CRON=true
# CA-Zertifikat, dem verify_release.sh bei den Domain-Checks vertraut (z. B. Test-CA eines
# privaten Test-Hosts), absolut oder relativ zum Repo.
# HOCX_VERIFY_CA_FILE=

# Leak-Prüfung neuer Passwörter (SEC-AUTH-015): on = HIBP-Range-API (nur 5 Hex-Zeichen des
# SHA-1 gehen raus, Rückfall lokale Liste), local-only = nur lokale Liste im Image, off = aus.
# PASSWORD_LEAK_CHECK=on
# PASSWORD_LEAK_MIN_COUNT=1   # ab so vielen Vorkommen in HIBP abgelehnt
# PASSWORD_LEAK_FETCH_PER_MINUTE=600   # HIBP-Abfragen je Minute, darüber lokale Liste
# PASSWORD_BREACH_RECHECK_DAYS=30      # Leak-Prüfung beim Login: Nachtjob merkt ältere Prüfungen vor
# Länder-Geolocation (Risikosignal «neues Land»): job-worker lädt DB-IP «IP to Country Lite»
# (CC BY 4.0) monatlich ins Volume geoip_data. false = kein Download (Signal entfällt still).
# GEOIP_AUTO_UPDATE=true
# Foto-Standorte: job-worker lädt Ortsdaten (GeoNames CC BY 4.0, swisstopo swissNAMES3D) in die
# Datenbank, erstmals ~70 MB, danach bei neuer Ausgabe. false = kein Download (scripts/import_geo_places).
# GEO_PLACES_AUTO_UPDATE=true
# Anmeldeschutz (Auth-Audit 2026-11-20, RUNBOOK «Anmeldeschutz»). Startwerte aus dem Audit.
# AUTH_RISK_MODE=enforce   # monitor = Risk Engine protokolliert nur
# AUTH_SESSION_IDLE_MINUTES=480
# AUTH_SESSION_ABSOLUTE_HOURS=336
# AUTH_EVENT_RETENTION_DAYS=90
# AUTH_STEP_UP_MFA_MINUTES=10
# AUTH_STEP_UP_ADMIN_MINUTES=15
# AUTH_ACCOUNT_IP_FAILURES=10
# AUTH_ACCOUNT_FAILURES_CHALLENGE=30
# AUTH_ACCOUNT_FAILURES_KNOWN_ONLY=100
# AUTH_IP_FAILURES_SOFT=20
# AUTH_IP_FAILURES_HARD=60
# AUTH_NET_FAILURES_SOFT=60
# AUTH_NET_FAILURES_HARD_HOUR=300
# AUTH_GLOBAL_ATTACK_MIN=100
# AUTH_BLOCK_STRIKES=3
# AUTH_BLOCK_MINUTES=60,360,1440
# AUTH_DEVICE_TTL_DAYS=90
# Schlüsselrotation: bisherigen AUTH_SECRET hier eintragen, neuen in AUTH_SECRET; nach 14 Tagen leeren.
# AUTH_SECRET_PREVIOUS=
# Bisheriger Cookie-Name hocx_session wird nur im Übergang gelesen (leer = Start + 72 h)
# AUTH_LEGACY_COOKIE_UNTIL=
# IPv6: L2-Grenzen je /48 = AUTH_NET_FAILURES_* x Faktor
# AUTH_NET6_FACTOR=4
