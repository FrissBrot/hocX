#!/usr/bin/env bash
# Blocks commits that (re-)introduce known sensitive strings (private domains,
# real tenant identifiers) or generic secrets. Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$REPO_ROOT/.gitleaks.toml"

# Sicherheitsregeln (SECURITY-RULES.md): nur neu eingefuehrte Verstoesse in gestagten Dateien.
# Gilt fuer alle Agents (Claude, Codex, Gemini, ...) und Menschen gleichermassen.
python3 "$REPO_ROOT/scripts/check-security-rules.py" --staged

# RBAC: Katalog vollstaendig (Uebersetzungen, Migration, Verwendung) und Rechte-Uebersicht
# permissions/route-map.json aktuell, sobald Routen, Berechtigungen oder der Katalog gestagt sind.
if git diff --cached --name-only | grep -qE '^(backend/app/api/routes/|backend/app/documents/permissions\.py|backend/app/main\.py|backend/tests/test_route_permission_inventory\.py|permissions/|backend/alembic/versions/|frontend/messages/[^/]+/roles\.json)'; then
  python3 "$REPO_ROOT/scripts/sync-permission-catalog.py" --check
  python3 "$REPO_ROOT/scripts/sync-route-permissions.py" --check
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config "$CONFIG" --redact
  exit $?
fi

echo "hocx pre-commit: gitleaks nicht installiert, nutze eingeschraenkten Fallback-Check." >&2
echo "  Fuer vollen Schutz (auch generische Secrets): apt-get install gitleaks" >&2

BLOCKED_PATTERN='tweber\.ch|jwsachseln\.ch'
if git diff --cached -U0 | grep -E '^\+[^+]' | grep -InE "$BLOCKED_PATTERN"; then
  echo "" >&2
  echo "Commit blockiert: die oben markierte(n) Zeile(n) enthalten eine private" >&2
  echo "oder kundenspezifische Domain, die nicht ins Repo gehoert." >&2
  exit 1
fi

exit 0
