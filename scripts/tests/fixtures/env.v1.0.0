# Beispiel-.env, so wie scripts/deploy.sh von Release 1.0.0 (Tag v1.0.0) sie erzeugt hat -
# alle Werte sind Platzhalter. Fixture fuer scripts/tests/test_env_migrate.sh: ein Update auf
# 1.1.0 muss mit genau so einer Datei ohne manuelles Nachpflegen durchlaufen.
HOCX_VERSION='v1.0.0'
HOCX_ENVIRONMENT='prod'
GHCR_NAMESPACE='frissbrot'
HOCX_SIGNING_IDENTITY_REGEXP='(?i)^https://github.com/frissbrot/hocx/.github/workflows/build-test-images[.]yml@refs/heads/main$'
ROUTER_PREFIX='hocx'
POSTGRES_DB='hocx'
POSTGRES_USER='hocx'
POSTGRES_PASSWORD='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
DATABASE_URL='postgresql+psycopg://hocx:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@db:5432/hocx'
APP_DB_PASSWORD='bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
APP_DATABASE_URL='postgresql+psycopg://hocx_app:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb@db:5432/hocx'
TRAEFIK_DOMAIN='hocx.ch'
TRAEFIK_ADMIN_DOMAIN='admin.hocx.ch'
TRAEFIK_ADMIN_PORT='8443'
ACME_EMAIL='ops@example.org'
CF_DNS_API_TOKEN='fake-cloudflare-token'
TRAEFIK_WEB_BIND='0.0.0.0'
TRAEFIK_WEBSECURE_BIND='0.0.0.0'
TRAEFIK_CERTRESOLVER='letsencrypt'
HOCX_STORAGE_PATH='./storage'
NEXT_PUBLIC_API_URL='https://hocx.ch'
INTERNAL_API_URL='http://backend:8000'
TRAEFIK_DOCS_DOMAIN='docs.hocx.ch'
TRAEFIK_WEB_DOMAIN='web.hocx.ch'
AUTH_SECRET='cccccccccccccccccccccccccccccccc'
ADMIN_AUTH_SECRET='dddddddddddddddddddddddddddddddd'
INITIAL_ADMIN_EMAIL='admin@hocx.ch'
INITIAL_ADMIN_PASSWORD='eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee'
TRAEFIK_ABGABEBOX_DOMAIN='abgabe.hocx.ch'
ABGABEBOX_DB_PASSWORD='ffffffffffffffffffffffffffffffff'
ABGABEBOX_DATABASE_URL='postgresql+psycopg://hocx_abgabebox:ffffffffffffffffffffffffffffffff@db:5432/hocx'
FRIENDLY_CAPTCHA_SITEKEY=''
FRIENDLY_CAPTCHA_API_KEY=''
ABGABEBOX_CAPTCHA_SESSION_SECRET='99999999999999999999999999999999'
