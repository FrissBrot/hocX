# Test-Umgebung auf eigenem Host (docker-compose.release.yml +
# docker-compose.clamav.yml + docker-compose.traefik.yml + docker-compose.test.yml).
# Kopie als .env anlegen, echte Werte eintragen - NIE committen.
#
# HOCX_VERSION zeigt hier auf den automatisch generierten Candidate-Tag aus
# .github/workflows/build-test-images.yml.

HOCX_VERSION=test-20260825-abc1234-r42
HOCX_ENVIRONMENT=test
GHCR_NAMESPACE=your-github-org-lowercase
HOCX_SIGNING_IDENTITY_REGEXP=(?i)^https://github.com/your-github-org-lowercase/hocx/.github/workflows/build-test-images[.]yml@refs/heads/main$
# HOCX_MIN_FREE_KB=2097152
# Eigener Praefix fuer Test, damit Router-/Service-Namen auch bei spaeteren Erweiterungen
# klar getrennt bleiben.
ROUTER_PREFIX=hocx-test

POSTGRES_DB=hocx
POSTGRES_USER=hocx
POSTGRES_PASSWORD=change-me-to-a-random-32-plus-char-value
DATABASE_URL=postgresql+psycopg://hocx:change-me-to-a-random-32-plus-char-value@db:5432/hocx
APP_DB_PASSWORD=change-me-to-a-different-random-32-plus-char-value
APP_DATABASE_URL=postgresql+psycopg://hocx_app:change-me-to-a-different-random-32-plus-char-value@db:5432/hocx
TRAEFIK_DOMAIN=test.hocx.ch
TRAEFIK_ADMIN_DOMAIN=admin.test.hocx.ch
# Oeffentliche Website/Landing Page (optional, z.B. die Hauptdomain hocx.ch). Leer = keine Website.
TRAEFIK_WEBSITE_DOMAIN=
# Kontaktadresse der Website (Demo/Kontakt/Plan-Buttons als mailto). Leer = Buttons fuehren zum App-Login.
WEBSITE_CONTACT_EMAIL=
# Ziel von "Anmelden" auf der Website (z.B. https://app.hocx.ch). Leer = https://${TRAEFIK_DOMAIN}.
HOCX_APP_URL=
TRAEFIK_ADMIN_PORT=8443
# Host-eigene Dateien in infra/traefik/dynamic/ (nicht im Repo, z. B. eigenes TLS-Zertifikat);
# nur hier genannte Dateinamen lässt die Deploy-Prüfung zu (Leerzeichen/Komma getrennt).
TRAEFIK_HOST_DYNAMIC_FILES=
ACME_EMAIL=your@email.com
CF_DNS_API_TOKEN=replace-with-a-restricted-cloudflare-api-token

# Test-Host soll wie der Admin-Zugang rein privat ueber OpenZiti laufen, nicht oeffentlich
# im Internet stehen: 80/443 nur an 127.0.0.1 binden und Zertifikate ueber die
# Cloudflare-DNS-01-Challenge statt HTTP-01 beziehen (HTTP-01 wuerde auf einem privaten
# Port ohnehin fehlschlagen). Fuer Prod bleiben beide Variablen unentfernt/ungesetzt
# (Default: oeffentlich, HTTP-01).
TRAEFIK_WEB_BIND=127.0.0.1
TRAEFIK_WEBSECURE_BIND=127.0.0.1
TRAEFIK_CERTRESOLVER=letsencryptdns

# Host-Pfad fuer die auslagerbaren Originale/Exporte (StoredFile, exports, Dokumentvorlagen -
# siehe FileService). Default ist der lokale Ordner; sobald ein Cloud Volume gemountet ist,
# hier z.B. auf /mnt/hocx-test-data umstellen und "docker compose up -d" - kein
# Code-/Compose-Aendern noetig. storage-local/thumbnails ist bewusst NICHT darueber
# steuerbar, bleibt immer lokal.
HOCX_STORAGE_PATH=./storage

# Nur beim Update von 1.0.x auf 1.1.0 relevant (Migration 0078, "ein Konto = ein Mandant"):
# "auto" loest Konten mit mehreren Mandanten-Mitgliedschaften automatisch auf (behaelt die
# Mitgliedschaft des Standard-Mandanten, sonst die hoechste Rolle) und LOESCHT Konten ohne
# jeden Mandanten. Leer lassen, dann bricht die Migration in dem Fall ab und listet die Konten.
# HOCX_SINGLE_TENANT_RESOLUTION=auto

NEXT_PUBLIC_API_URL=https://test.hocx.ch
INTERNAL_API_URL=http://backend:8000
TRAEFIK_DOCS_DOMAIN=docs-test.hocx.ch
# Optional: öffentliche Statusseite (nur https). Die Update-Seite verweist darauf, wenn ein Update
# länger als 15 Minuten dauert (In-App und statische Wartungsseite, RUNBOOK Abschnitt 20).
# HOCX_STATUS_PAGE_URL=https://status.example.com
AUTH_SECRET=change-me-to-a-random-32-plus-char-value

ADMIN_AUTH_SECRET=change-me-to-a-different-random-32-plus-char-value
# Nachweis «kam über den Admin-Entrypoint» (Auth-Audit SEC-AUTH-001): Traefik setzt den Wert an
# jedem Admin-Router als Header, das Backend nimmt /api/admin nur damit an. Von deploy.sh einmalig
# erzeugt (64 Hex) und als infra/traefik/dynamic/admin-gate.yml für Traefik geschrieben. Ohne Wert
# ist die Admin-API in production/test gesperrt (RUNBOOK, Admin-Zugang).
ADMIN_GATE_SECRET=
# Quelladresse des Admin-Zugangs (Traefik ipAllowList). Leer = Gateway des Compose-Netzes
# <projekt>_edge, über das der Ziti-Tunnel via 127.0.0.1:<TRAEFIK_ADMIN_PORT> ankommt.
# HOCX_ADMIN_SOURCE_CIDRS=
# Höchstzahl Mandanten-Domains, die Deploy/verify_release.sh auf gesperrte Admin-Pfade prüfen.
# HOCX_VERIFY_TENANT_DOMAIN_LIMIT=20
INITIAL_ADMIN_EMAIL=admin@test.hocx.ch
INITIAL_ADMIN_PASSWORD=change-me-before-first-deploy

TRAEFIK_ABGABEBOX_DOMAIN=abgabe-test.hocx.ch
ABGABEBOX_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
ABGABEBOX_DATABASE_URL=postgresql+psycopg://hocx_abgabebox:change-me-to-a-random-32-plus-char-value@db:5432/hocx
PHOTO_WORKER_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
PHOTO_WORKER_DATABASE_URL=postgresql+psycopg://hocx_photo_worker:change-me-to-a-random-32-plus-char-value@db:5432/hocx
# Foto-Standorte (Migration 0260): eigene Rolle nur für den Import der Ortsdaten (job-worker).
GEO_DB_PASSWORD=change-me-to-a-random-32-plus-char-value
GEO_DATABASE_URL=postgresql+psycopg://hocx_geo:change-me-to-a-random-32-plus-char-value@db:5432/hocx

# Redis-Passwort (requirepass), nur im Release-Stack aktiv (MAIN-OPS-005).
REDIS_PASSWORD=change-me-to-a-random-32-plus-char-value
FRIENDLY_CAPTCHA_SITEKEY=your-friendly-captcha-sitekey
FRIENDLY_CAPTCHA_API_KEY=your-friendly-captcha-api-key
ABGABEBOX_CAPTCHA_SESSION_SECRET=change-me-to-a-random-32-plus-char-value

# Base32 TOTP secret that scripts/seed_test_tenant.py enrolls for every demo account (platform
# admins use passkeys only, Migration 0205) - add the same secret once to your own authenticator app and every test-deploy
# reseed keeps working with it. Left empty, deploy.sh (scripts/lib/env_migrate.sh) generates one
# on the first test deploy and keeps it from then on.
DEMO_TOTP_SEED=

# --- Objektspeicher (S3) und lokales Garage-S3 (docs-site/docs/technik/storage/) ---
# deploy.sh erzeugt fehlende Werte automatisch (scripts/lib/env_migrate.sh) und überschreibt nie
# vorhandene. STORAGE_CREDENTIALS_KEY zusammen mit .env sichern - ohne ihn sind gespeicherte
# S3-Zugangsdaten nicht mehr entschlüsselbar. Garage-Access-Keys: GK + 24 Hex, Secrets: 64 Hex.
STORAGE_CREDENTIALS_KEY=
# Schlüssel der Mandanten-Exporte (64 Hex, von deploy.sh einmalig erzeugt). Zusammen mit .env
# sichern - ohne ihn sind Exporte, die ohne Passwort erstellt wurden, nicht mehr importierbar.
EXPORT_ENCRYPTION_KEY=

# --- Datei-Import aus Cloud-Diensten (RUNBOOK «Cloud-Import einrichten») ---
# Schlüssel der OAuth-Tokens (64 Hex, von deploy.sh einmalig erzeugt). Rotation: neuen Wert setzen,
# alten als CLOUD_IMPORT_TOKEN_KEY_PREVIOUS, nach 7 Tagen _PREVIOUS leeren.
CLOUD_IMPORT_TOKEN_KEY=
CLOUD_IMPORT_TOKEN_KEY_PREVIOUS=
CLOUD_IMPORT_ENABLED=true
# Basis der Redirect-URI; leer = https://TRAEFIK_DOMAIN
CLOUD_IMPORT_REDIRECT_BASE_URL=
# Microsoft Entra App (OneDrive, SharePoint). Leer = Microsoft wird nicht angeboten.
CLOUD_IMPORT_MS_CLIENT_ID=
CLOUD_IMPORT_MS_CLIENT_SECRET=
# Ablaufdatum des Client-Secrets (JJJJ-MM-TT) für den Monitoring-Check «Cloud-Import»
CLOUD_IMPORT_MS_CLIENT_SECRET_EXPIRES=
CLOUD_IMPORT_MS_AUTHORITY=common
# auto | tempauth | bearer (Download OneDrive for Business/SharePoint, tempauth endet am 1.4.2027)
CLOUD_IMPORT_MS_DOWNLOAD_MODE=auto
# Gleichzeitige Downloads je Import (1-8, Standard 2)
CLOUD_IMPORT_MAX_PARALLEL_DOWNLOADS=2
# Google-Cloud-Projekt (Google Drive + Google Fotos). Leer = Google wird nicht angeboten.
# Redirect-URIs: <Basis>/api/cloud-import/oauth/google_drive/callback und …/google_photos/callback
CLOUD_IMPORT_GOOGLE_CLIENT_ID=
CLOUD_IMPORT_GOOGLE_CLIENT_SECRET=
# Optional: Ablaufdatum des Client-Secrets (JJJJ-MM-TT), nur wenn es ablaufen soll
CLOUD_IMPORT_GOOGLE_CLIENT_SECRET_EXPIRES=
# Picker (nur Google Drive): Browser-API-Key (öffentlich, auf Referrer + Picker API beschränken) und
# Projektnummer des Google-Cloud-Projekts
CLOUD_IMPORT_GOOGLE_API_KEY=
CLOUD_IMPORT_GOOGLE_APP_ID=
# Eigene Subdomain für die Google-Auswahl (Picker) ohne hocX-Sitzung, z. B. picker.hocx.ch: DNS-Eintrag
# auf den Server, Zertifikat holt Traefik. Leer = Google Drive wird nicht angeboten (RUNBOOK 27.2).
CLOUD_IMPORT_PICKER_DOMAIN=
# Dropbox-App (Scoped access, nur files.metadata.read + files.content.read). Leer = Dropbox wird nicht
# angeboten. Anleitung: RUNBOOK «Cloud-Import einrichten», Abschnitt Dropbox.
CLOUD_IMPORT_DROPBOX_APP_KEY=
CLOUD_IMPORT_DROPBOX_APP_SECRET=
# WebDAV (kDrive, Nextcloud, SwissDisk …): keine Registrierung nötig; false = nicht anbieten
CLOUD_IMPORT_WEBDAV_ENABLED=true
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
LOCAL_S3_ACCESS_KEY=
LOCAL_S3_SECRET_KEY=
LOCAL_S3_ABGABEBOX_ACCESS_KEY=
LOCAL_S3_ABGABEBOX_SECRET_KEY=
# Rückfallfrist abgelöster Speichergenerationen in Tagen
STORAGE_FALLBACK_DAYS=14

# --- Offsite-Backup: BorgBackup auf der Hetzner Storage Box (docs-site/docs/technik/backup/) ---
# Erst nach der Einrichtung (RUNBOOK Abschnitt 7) auf true setzen. Solange false, läuft der
# backup-worker im Leerlauf und die bisherigen Cronjobs backup_db/backup_storage bleiben aktiv.
BACKUP_ENABLED=false
BACKUP_STORAGEBOX_HOST=
BACKUP_STORAGEBOX_USER=
BACKUP_STORAGEBOX_PORT=23
BACKUP_REPOSITORY_PATH=hocx-borg
# Borg-Version auf der Storage Box (Hetzner bietet mehrere an)
BACKUP_REMOTE_PATH=borg-1.4
# Nach "cli init" ausgegebene Repository-ID (64 Hex) - Pinning gegen vertauschte Repositories
BACKUP_REPOSITORY_ID=
# Host-Key-Pinning: entweder known_hosts-Datei (BACKUP_KNOWN_HOSTS_PATH) oder SHA256-Fingerprint
BACKUP_SSH_HOST_FINGERPRINT=
# Pfade auf dem Host (Modus 600, Besitzer Deploy-Benutzer); deploy.sh kopiert sie nach .secrets/
BACKUP_SSH_KEY_PATH=
BACKUP_KNOWN_HOSTS_PATH=
BACKUP_PASSPHRASE=
# Lokales Staging (Datenbank-Dump) in Bytes, Upload-Limit in KiB/s (0 = unbegrenzt)
BACKUP_STAGING_MAX_BYTES=21474836480
BACKUP_UPLOAD_RATELIMIT_KIB=0
# Kapazität der Storage Box in Bytes für die Belegungswarnung (0 = unbekannt)
BACKUP_STORAGEBOX_QUOTA_BYTES=0
# Vor jedem Deploy ein geschütztes, abgeschlossenes Backup verlangen (required) oder bewusst
# darauf verzichten (skip, wird protokolliert). Zeitlimit in Sekunden.
HOCX_PRE_DEPLOY_BACKUP=required
HOCX_PRE_DEPLOY_BACKUP_TIMEOUT=7200

# Öffentliche Prüfseite für PDFs (Abgabebox /verify). Steht in jedem PDF (Fusszeile, QR-Code,
# XMP) - bewusst die Plattform-Domain, gedruckte Links müssen stabil bleiben.
# Leer = ABGABEBOX_BASE_URL + /verify.
# DOCUMENT_VERIFY_BASE_URL=https://abgabe.example.com/verify

# --- Betrieb (optional) ---------------------------------------------------------------------
# deploy.sh traegt benoetigte Host-Cronjobs (storage_controller) selbst in die crontab des
# Deploy-Benutzers ein; false = von Hand verwalten (RUNBOOK Abschnitt 10).
# HOCX_MANAGE_CRON=true
# CA-Zertifikat, dem verify_release.sh bei den Domain-Checks vertraut (z. B. Test-CA eines
# privaten Test-Hosts), absolut oder relativ zum Repo.
# HOCX_VERIFY_CA_FILE=

# Leak-Prüfung neuer Passwörter (SEC-AUTH-015): on = HIBP-Range-API (nur 5 Hex-Zeichen des
# SHA-1 gehen raus, Rückfall lokale Liste), local-only = nur lokale Liste im Image, off = aus.
# PASSWORD_LEAK_CHECK=on
# PASSWORD_LEAK_MIN_COUNT=1   # ab so vielen Vorkommen in HIBP abgelehnt
# Länder-Geolocation (Risikosignal «neues Land»): job-worker lädt DB-IP «IP to Country Lite»
# (CC BY 4.0) monatlich ins Volume geoip_data. false = kein Download (Signal entfällt still).
# GEOIP_AUTO_UPDATE=true
# Anmeldeschutz (Auth-Audit 2026-11-20, RUNBOOK «Anmeldeschutz»). Startwerte aus dem Audit.
# AUTH_RISK_MODE=enforce   # monitor = Risk Engine protokolliert nur
# AUTH_SESSION_IDLE_MINUTES=480
# AUTH_SESSION_ABSOLUTE_HOURS=336
# AUTH_EVENT_RETENTION_DAYS=90
# AUTH_STEP_UP_MFA_MINUTES=10
# AUTH_STEP_UP_ADMIN_MINUTES=15
# AUTH_ACCOUNT_IP_FAILURES=10
# AUTH_ACCOUNT_FAILURES_CHALLENGE=30
# AUTH_ACCOUNT_FAILURES_KNOWN_ONLY=100
# AUTH_IP_FAILURES_SOFT=20
# AUTH_IP_FAILURES_HARD=60
# AUTH_NET_FAILURES_SOFT=60
# AUTH_NET_FAILURES_HARD_HOUR=300
# AUTH_GLOBAL_ATTACK_MIN=100
# AUTH_BLOCK_STRIKES=3
# AUTH_BLOCK_MINUTES=60,360,1440
# AUTH_DEVICE_TTL_DAYS=90
# Schlüsselrotation: bisherigen AUTH_SECRET hier eintragen, neuen in AUTH_SECRET; nach 14 Tagen leeren.
# AUTH_SECRET_PREVIOUS=
# Bisheriger Cookie-Name hocx_session wird nur im Übergang gelesen (leer = Start + 72 h)
# AUTH_LEGACY_COOKIE_UNTIL=
# IPv6: L2-Grenzen je /48 = AUTH_NET_FAILURES_* x Faktor
# AUTH_NET6_FACTOR=4
