POSTGRES_DB=hocx_e2e
POSTGRES_USER=hocx_e2e
POSTGRES_PASSWORD=hocx_e2e
DATABASE_URL=postgresql+psycopg://hocx_e2e:hocx_e2e@db:5432/hocx_e2e
APP_DB_PASSWORD=hocx_app_e2e
APP_DATABASE_URL=postgresql+psycopg://hocx_app:hocx_app_e2e@db:5432/hocx_e2e
HOCX_STORAGE_PATH=./storage-e2e
HOCX_VERSION=e2e
NEXT_PUBLIC_API_URL=http://127.0.0.1:13000
INTERNAL_API_URL=http://backend:8000
AUTH_SECRET=e2e-auth-secret-0123456789-0123456789
ADMIN_AUTH_SECRET=e2e-admin-secret-0123456789-0123456789
INITIAL_ADMIN_EMAIL=platform-admin@hocx.local
INITIAL_ADMIN_PASSWORD=ChangeMe123!
ABGABEBOX_DB_PASSWORD=hocx_abgabebox_e2e
ABGABEBOX_DATABASE_URL=postgresql+psycopg://hocx_abgabebox:hocx_abgabebox_e2e@db:5432/hocx_e2e
ABGABEBOX_CAPTCHA_SESSION_SECRET=e2e-captcha-secret-0123456789
TRAEFIK_DOMAIN=
TRAEFIK_ADMIN_DOMAIN=
TRAEFIK_ABGABEBOX_DOMAIN=
TRAEFIK_DOCS_DOMAIN=
ACME_EMAIL=e2e@example.invalid
CF_DNS_API_TOKEN=e2e-unused
FRIENDLY_CAPTCHA_SITEKEY=
FRIENDLY_CAPTCHA_API_KEY=
# Controls CAPTCHA fail-open (dev/test) vs fail-closed (default/production) behavior in
# abgabebox-backend/app/config.py. Must be a dev/test value here since no real FriendlyCaptcha
# keys are configured above. Leave unset (or "production") in real prod deployments.
ABGABEBOX_ENVIRONMENT=development
